# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qflow_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Alternative: Full Connection String (Takes precedence if provided)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/qflow_db

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# CORS - Allowed Frontend Origin
# Set this to the URL of your React frontend.
# Local Vite dev server (default): http://localhost:5173
# Production example           : https://yourapp.example.com
# Do NOT use * in production — that would allow any website to call your API.
CLIENT_URL=http://localhost:5173
