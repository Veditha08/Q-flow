# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qflow_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative: Full Connection String (Takes precedence if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qflow_db

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d
